# DeTSP 配置示例：复制为 .env 后填写。只填 API 钱包/签名私钥，
# 永远不要填主钱包私钥或助记词。本文件只留空值模板。

# ===== 全局 =====
# DRY_RUN=true 时只决策不下单（paper 之外的第二层保险）
DRY_RUN=true
# 网页面板绑定：无鉴权，只允许本机。端口默认 8320（WEB_PORT 优先于 PORT）
HOST=127.0.0.1
PORT=8320
WEB_PORT=8320

# ===== Arcus =====
ARCUS_ADDRESS=
ARCUS_ACCOUNT_INDEX=
ARCUS_API_KEY=
ARCUS_API_PRIVATE_KEY=
ARCUS_API_PRIVATE_KEY_FILE=
ARCUS_PROXY=

# ===== Lighter 主网 =====
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=
LIGHTER_API_PRIVATE_KEY_FILE=
LIGHTER_PROXY=

# ===== Lighter Robinhood 链（与主网是独立账户/密钥）=====
LIGHTER_RH_ACCOUNT_INDEX=
LIGHTER_RH_API_KEY_INDEX=
LIGHTER_RH_API_PRIVATE_KEY=
LIGHTER_RH_API_PRIVATE_KEY_FILE=
LIGHTER_RH_PROXY=

# ===== Hyperliquid 家族（本体 / Entropy=io / trade.xyz=xyz 共用 API 钱包）=====
HL_ACCOUNT_ADDRESS=
HL_PRIVATE_KEY=
# trade.xyz 如需与本体分开账户，再填下面两个（留空则共用）
HL_ACCOUNT_ADDRESS_XYZ=
HL_PRIVATE_KEY_XYZ=
HL_PROXY=

# ===== Aster =====
ASTER_API_KEY=
ASTER_SECRET_KEY=
ASTER_PROXY=
